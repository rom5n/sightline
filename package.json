{
  "name": "sightline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "engine": "node scripts/engine.mjs",
    "gen:types": "node scripts/py.mjs scripts/gen_ts.py",
    "test:engine": "node scripts/py.mjs -m pytest engine/tests -q",
    "test:e2e": "playwright test",
    "build:engine": "node scripts/build-engine.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:version": "node scripts/version.mjs",
    "build:app": "npm run build:engine && tauri build --config src-tauri/tauri.bundle.json"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "dockview-react": "^8.6.0",
    "i18next": "^26.5.2",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "motion": "^14.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.4"
  }
}
