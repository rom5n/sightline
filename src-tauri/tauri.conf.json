{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sightline",
  "version": "../package.json",
  "identifier": "app.sightline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sightline",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#0C0E10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sightline",
    "shortDescription": "See how machine-learning models learn",
    "longDescription": "Sightline lets you pick a scikit-learn model, give it data and watch it learn, step by step.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Russian"
        ]
      },
      "wix": {
        "language": [
          "en-US",
          "ru-RU"
        ]
      }
    },
    "category": "Education",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "science"
      }
    }
  }
}
